{
  "version": 4,
  "configurePresets": [
    {
      "name": "build_demos",
      "displayName": "Build Demos",
      "description": "Preset to build demos",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "23",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_C_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MY_BUILD_DEMOS": "ON"
      }
    },
    {
      "name": "build_tests",
      "displayName": "Build Tests",
      "description": "Preset to build tests",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "23",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_C_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MY_BUILD_TESTS": "ON"
      }
    }
  ]
}
